---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "VeYo Smart Solutions | Slimmer wonen. Beter leven.",
	description =
		"Professionele smart home-oplossingen, netwerken, beveiliging, verlichting en automatisatie in West- en Oost-Vlaanderen.",
} = Astro.props;

const siteUrl = "https://veyosmartsolutions.com";
const faviconUrl = `${siteUrl}/veyo-favicon.png`;
const socialImage = `${siteUrl}/og-image.png`;

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	name: "VeYo Smart Solutions",
	url: siteUrl,
	logo: faviconUrl,
	image: socialImage,
	description,
	telephone: "+32456536037",
	email: "info@veyosmartsolutions.com",
	vatID: "BE1037811809",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Jabbeke",
		addressRegion: "West-Vlaanderen",
		addressCountry: "BE",
	},
	areaServed: [
		{
			"@type": "AdministrativeArea",
			name: "West-Vlaanderen",
		},
		{
			"@type": "AdministrativeArea",
			name: "Oost-Vlaanderen",
		},
	],
	sameAs: [
		"https://www.facebook.com/VeYoSmartSolutions/",
		"https://www.instagram.com/veyosmartsolutions/",
	],
};
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>

		<meta name="description" content={description} />
		<meta name="author" content="VeYo Smart Solutions" />
		<meta name="theme-color" content="#090909" />

		<link rel="icon" type="image/png" href="/veyo-favicon.png?v=10" />
		<link rel="apple-touch-icon" href="/veyo-favicon.png?v=10" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="nl_BE" />
		<meta property="og:site_name" content="VeYo Smart Solutions" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="VeYo Smart Solutions logo"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify(localBusinessSchema)}
		/>

		<!-- Google Analytics: standaard geen toestemming -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];

  function gtag() {
    dataLayer.push(arguments);
  }

  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500
  });

  gtag('js', new Date());
  gtag('config', 'G-F18859SKSZ');
</script>

<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-F18859SKSZ"
></script>
	</head>

	<body>
		<slot />
		<Footer />
		<WhatsAppButton />
		<CookieBanner />
	</body>
</html>