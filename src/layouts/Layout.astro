---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = "Smart Home, WiFi & slimme technologie | VeYo Smart Solutions",
	description =
		"VeYo Smart Solutions helpt particulieren en kleine bedrijven met smart home, professionele WiFi, netwerken, slimme verlichting, automatisatie en andere slimme oplossingen in West- en Oost-Vlaanderen.",
	image = "/og-image.png",
	noindex = false,
} = Astro.props;

const siteUrl = "https://veyosmartsolutions.com";

/*
 * Canonical URL van de huidige pagina.
 */
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

/*
 * Afbeeldingen
 */
const socialImage = new URL(image, siteUrl).toString();
const businessImage = new URL("/og-image.png", siteUrl).toString();
const faviconUrl = new URL("/veyo-favicon.png", siteUrl).toString();

/*
 * Structured data
 */
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			url: `${siteUrl}/`,
			name: "VeYo Smart Solutions",
			description:
				"Smart home, professionele WiFi, netwerken, slimme verlichting en automatisatie in West- en Oost-Vlaanderen.",
			publisher: {
				"@id": `${siteUrl}/#business`,
			},
			inLanguage: "nl-BE",
		},

		{
			"@type": "LocalBusiness",
			"@id": `${siteUrl}/#business`,
			name: "VeYo Smart Solutions",
			url: `${siteUrl}/`,
			image: businessImage,
			logo: faviconUrl,

			description:
				"VeYo Smart Solutions is een installateur van smart home-oplossingen, professionele WiFi, netwerken, slimme verlichting, automatisatie en slimme technologie voor woningen en kleine bedrijven in West- en Oost-Vlaanderen.",

			telephone: "+32456536037",
			email: "info@veyosmartsolutions.com",
			vatID: "BE1037811809",

			founder: {
				"@type": "Person",
				name: "Yordi Verheecke",
			},

			address: {
				"@type": "PostalAddress",
				addressLocality: "Jabbeke",
				addressRegion: "West-Vlaanderen",
				addressCountry: "BE",
			},

			areaServed: [
				{
					"@type": "AdministrativeArea",
					name: "West-Vlaanderen",
				},
				{
					"@type": "AdministrativeArea",
					name: "Oost-Vlaanderen",
				},
			],

			contactPoint: {
				"@type": "ContactPoint",
				telephone: "+32456536037",
				email: "info@veyosmartsolutions.com",
				contactType: "customer service",
				availableLanguage: ["Dutch"],
				areaServed: "BE",
			},

			knowsAbout: [
				"Smart home",
				"Domotica",
				"Smart home automatisatie",
				"WiFi-installatie",
				"Thuisnetwerken",
				"Netwerkinstallatie",
				"Slimme verlichting",
				"Energiebeheer",
				"Multiroom audio",
				"Home cinema",
				"Slimme deursloten",
				"Videodeurbellen",
			],

			sameAs: [
				"https://www.facebook.com/VeYoSmartSolutions/",
				"https://www.instagram.com/veyosmartsolutions/",
			],
		},

		{
			"@type": "WebPage",
			"@id": `${canonicalUrl}#webpage`,
			url: canonicalUrl,
			name: title,
			description: description,
			isPartOf: {
				"@id": `${siteUrl}/#website`,
			},
			about: {
				"@id": `${siteUrl}/#business`,
			},
			inLanguage: "nl-BE",
		},
	],
};
---

<!doctype html>
<html lang="nl-BE">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>

		<!-- Algemene SEO -->
		<meta name="description" content={description} />
		<meta name="author" content="VeYo Smart Solutions" />
		<meta
			name="robots"
			content={noindex ? "noindex, nofollow" : "index, follow"}
		/>
		<meta name="theme-color" content="#090909" />

		<!-- Canonical -->
		<link rel="canonical" href={canonicalUrl} />

		<!-- Favicon -->
		<link
			rel="icon"
			type="image/png"
			href="/veyo-favicon.png?v=10"
		/>

		<link
			rel="apple-touch-icon"
			href="/veyo-favicon.png?v=10"
		/>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="nl_BE" />
		<meta property="og:site_name" content="VeYo Smart Solutions" />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />

		<meta property="og:image" content={socialImage} />
		<meta property="og:image:secure_url" content={socialImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta
			property="og:image:alt"
			content="VeYo Smart Solutions – Slimmer wonen. Beter leven."
		/>

		<!-- X / Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		<meta
			name="twitter:image:alt"
			content="VeYo Smart Solutions – Slimmer wonen. Beter leven."
		/>

		<!-- Structured data -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>

		<!-- Google Analytics: standaard geen toestemming -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];

			function gtag() {
				window.dataLayer.push(arguments);
			}

			window.gtag = gtag;

			gtag("consent", "default", {
				analytics_storage: "denied",
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
				wait_for_update: 500,
			});

			gtag("js", new Date());

			gtag("config", "G-F18859SKSZ");
		</script>

		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-F18859SKSZ"
		></script>
	</head>

	<body>
		<slot />

		<Footer />
		<WhatsAppButton />
		<CookieBanner />
	</body>
</html>