---
import {
	Handshake,
	Wrench,
	Building2,
	MapPin,
} from "lucide-astro";

const highlights = [
	{
		icon: Handshake,
		text: "Persoonlijk advies en rechtstreeks contact",
	},
	{
		icon: Wrench,
		text: "Installatie, configuratie en duidelijke uitleg",
	},
	{
		icon: Building2,
		text: "Oplossingen voor woningen en kleine bedrijven",
	},
	{
		icon: MapPin,
		text: "Gevestigd in Jabbeke, actief in West- en Oost-Vlaanderen",
	},
];
---

<section
	id="over-veyo"
	class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32"
	aria-labelledby="over-veyo-titel"
>
	<div
		class="absolute left-1/2 top-0 h-px w-[80%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#d4af37]/40 to-transparent"
	></div>

	<div
		class="absolute -left-40 top-1/2 h-[500px] w-[500px] -translate-y-1/2 rounded-full bg-[#d4af37]/5 blur-[150px]"
	></div>

	<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
		<div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">

			<!-- Fotoblok -->
			<div class="relative">
				<div
					class="relative min-h-[560px] overflow-hidden rounded-3xl border border-white/10 bg-[#111111]"
				>
					<img
						src="/images/profile/yordi.png"
						alt="Yordi Verheecke, oprichter van VeYo Smart Solutions in Jabbeke"
						loading="lazy"
						decoding="async"
						class="absolute inset-0 h-full w-full object-cover"
					/>

					<div
						class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent"
					></div>

					<div class="absolute inset-x-0 bottom-0 p-8 pt-32">
						<p
							class="text-sm font-bold uppercase tracking-[0.22em] text-[#d4af37]"
						>
							Het gezicht achter VeYo
						</p>

						<h3 class="mt-3 text-3xl font-black text-white">
							Yordi Verheecke
						</h3>

						<p class="mt-2 text-neutral-300">
							Oprichter van VeYo Smart Solutions
						</p>
					</div>

					<div
						class="absolute left-8 top-8 rounded-full border border-[#d4af37]/25 bg-black/40 px-4 py-2 text-sm font-bold text-[#d4af37] backdrop-blur-md"
					>
						Smart home • Netwerken • Slimme technologie
					</div>
				</div>
			</div>

			<!-- Tekstblok -->
			<div>
				<p
					class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
				>
					Over VeYo
				</p>

				<h2
					id="over-veyo-titel"
					class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
				>
					Persoonlijke service met een passie voor
					<span class="text-[#d4af37]"> slimme technologie.</span>
				</h2>

				<p class="mt-7 text-lg leading-8 text-neutral-400">
					VeYo Smart Solutions is gevestigd in Jabbeke en helpt particulieren
					en kleine bedrijven met slimme technologie voor woning en zaak.
					Van professionele WiFi en netwerken tot slimme verlichting,
					automatisatie en complete smart home-oplossingen.
				</p>

				<p class="mt-5 text-lg leading-8 text-neutral-400">
					Elke opdracht start met luisteren naar uw wensen. Daarna zoeken we
					naar een betrouwbare oplossing die aansluit bij uw woning, bestaande
					installatie en budget. We verzorgen de installatie, configuratie en
					geven duidelijke uitleg zodat u uw slimme systemen ook echt
					eenvoudig kunt gebruiken.
				</p>

				<ul class="mt-8 grid gap-4 sm:grid-cols-2">
					{
						highlights.map(({ icon: Icon, text }) => (
							<li
								class="group flex items-start gap-4 rounded-xl border border-white/10 bg-white/[0.025] p-4 transition duration-300 hover:-translate-y-0.5 hover:border-[#d4af37]/40 hover:bg-white/[0.045]"
							>
								<span
									class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37] transition duration-300 group-hover:scale-105 group-hover:border-[#d4af37]/55"
									aria-hidden="true"
								>
									<Icon
										size={22}
										strokeWidth={2}
										class="transition duration-300 group-hover:scale-110"
									/>
								</span>

								<span class="pt-1 leading-7 text-neutral-300">
									{text}
								</span>
							</li>
						))
					}
				</ul>

				<div class="mt-10 flex flex-col gap-4 sm:flex-row">
					<a
						href="#contact"
						class="inline-flex min-h-14 items-center justify-center rounded-lg bg-[#d4af37] px-7 font-bold text-black transition duration-300 hover:-translate-y-1 hover:bg-white"
					>
						Maak kennis met VeYo
					</a>

					<a
						href="#projecten"
						class="inline-flex min-h-14 items-center justify-center rounded-lg border border-white/15 px-7 font-bold text-white transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37]"
					>
						Bekijk onze realisaties
					</a>
				</div>
			</div>
		</div>
	</div>
</section>