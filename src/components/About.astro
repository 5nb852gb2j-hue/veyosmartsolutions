---
import {
	ArrowRight,
	House,
	MessageSquareText,
	UserRound,
	Wrench,
	Maximize2,
} from "lucide-astro";

const benefits = [
	{
		title: "Persoonlijk advies",
		description:
			"Geen standaardpakket, maar een oplossing die wordt afgestemd op uw woning, wensen en budget.",
		icon: UserRound,
	},
	{
		title: "Eén aanspreekpunt",
		description:
			"Van advies en materiaalkeuze tot installatie, configuratie en uitleg achteraf.",
		icon: House,
	},
	{
		title: "Netjes geïntegreerd",
		description:
			"We behouden bestaande schakelaars en installaties waar mogelijk en vermijden onnodige breekwerken.",
		icon: Wrench,
	},
	{
		title: "Klaar voor uitbreiding",
		description:
			"Uw installatie wordt zo opgebouwd dat later eenvoudig nieuwe slimme oplossingen kunnen worden toegevoegd.",
		icon: Maximize2,
	},
];
---

<section
	id="overons"
	class="relative overflow-hidden bg-[#090909] py-24 sm:py-32"
	aria-labelledby="overons-titel"
>
	<div
		class="absolute right-0 top-1/2 h-[520px] w-[520px] -translate-y-1/2 rounded-full bg-[#d4af37]/8 blur-[140px]"
	></div>

	<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
		<div class="grid items-center gap-16 lg:grid-cols-[0.9fr_1.1fr]">

			<!-- Tekst -->
			<div>
				<p
					class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
				>
					Waarom VeYo?
				</p>

				<h2
					id="overons-titel"
					class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
				>
					Technologie die werkt voor
					<span class="text-[#d4af37]"> uw dagelijks leven.</span>
				</h2>

				<p class="mt-7 max-w-xl text-lg leading-8 text-neutral-400">
					Een slimme woning hoeft niet ingewikkeld te zijn. VeYo Smart
					Solutions combineert persoonlijk advies, professionele plaatsing en
					een duidelijke uitleg tot één oplossing die u echt begrijpt en
					gebruikt.
				</p>

				<div class="mt-9 flex flex-wrap gap-4">
					<a
						href="#contact"
						class="group inline-flex min-h-14 items-center justify-center gap-3 rounded-lg bg-[#d4af37] px-7 font-bold text-black outline-none transition duration-300 hover:-translate-y-1 hover:bg-white focus-visible:ring-2 focus-visible:ring-white"
					>
						<MessageSquareText
							size={20}
							strokeWidth={2.2}
							aria-hidden="true"
							class="transition duration-300 group-hover:scale-110"
						/>

						Bespreek uw wensen
					</a>

					<a
						href="#projecten"
						class="group inline-flex min-h-14 items-center justify-center gap-3 rounded-lg border border-white/15 px-7 font-bold text-white outline-none transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37] focus-visible:ring-2 focus-visible:ring-[#d4af37]/70"
					>
						Bekijk onze projecten

						<ArrowRight
							size={19}
							strokeWidth={2.2}
							aria-hidden="true"
							class="transition duration-300 group-hover:translate-x-1"
						/>
					</a>
				</div>
			</div>

			<!-- Voordelen -->
			<div class="grid gap-5 sm:grid-cols-2">
				{
					benefits.map(({ icon: Icon, title, description }, index) => (
						<article
							class:list={[
								"group rounded-2xl border border-white/10 bg-white/[0.035] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#d4af37]/55 hover:bg-white/[0.055] hover:shadow-[0_18px_45px_rgba(0,0,0,0.24)]",
								index === 1 || index === 3 ? "sm:translate-y-8" : "",
							]}
						>
							<div
								class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37] transition duration-300 group-hover:scale-105 group-hover:border-[#d4af37]/55"
								aria-hidden="true"
							>
								<Icon
									size={25}
									strokeWidth={2}
									class="transition duration-300 group-hover:scale-110"
								/>
							</div>

							<h3 class="mt-6 text-xl font-bold text-white">
								{title}
							</h3>

							<p class="mt-3 leading-7 text-neutral-400">
								{description}
							</p>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>