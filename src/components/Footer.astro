---
import {
	ArrowRight,
	BadgeCheck,
	ExternalLink,
	FileText,
	Handshake,
	Mail,
	MapPin,
	MessageSquareText,
	Phone,
	ReceiptText,
	Wrench,
} from "lucide-astro";

const currentYear = new Date().getFullYear();

const quickLinks = [
	{ label: "Home", href: "/" },
	{ label: "Diensten", href: "/#diensten" },
	{ label: "Projecten", href: "/#projecten" },
	{ label: "Merken", href: "/#merken" },
	{ label: "FAQ", href: "/#faq" },
	{ label: "Over VeYo", href: "/#over-veyo" },
	{ label: "Contact", href: "/#contact" },
];

const services = [
	"Smart home & automatisatie",
	"WiFi & netwerken",
	"Slimme verlichting",
	"Camera’s & beveiliging",
	"Audio & home cinema",
	"Slimme toegang",
];

const strengths = [
	{
		icon: Handshake,
		text: "Persoonlijk advies",
	},
	{
		icon: Wrench,
		text: "Installatie op maat",
	},
	{
		icon: BadgeCheck,
		text: "Betrouwbare merken",
	},
	{
		icon: MessageSquareText,
		text: "Duidelijke uitleg & nazorg",
	},
];

const socialLinks = [
	{
		name: "Facebook",
		href: "https://www.facebook.com/VeYoSmartSolutions/",
	},
	{
		name: "Instagram",
		href: "https://www.instagram.com/veyosmartsolutions/",
	},
];
---

<footer class="relative overflow-hidden border-t border-white/10 bg-[#070707]">
	<div
		class="absolute left-1/2 top-0 h-px w-[85%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#d4af37]/55 to-transparent"
	></div>

	<div
		class="absolute -right-48 top-16 h-[460px] w-[460px] rounded-full bg-[#d4af37]/5 blur-[150px]"
	></div>

	<div
		class="absolute -left-52 bottom-0 h-[420px] w-[420px] rounded-full bg-[#d4af37]/[0.035] blur-[150px]"
	></div>

	<div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8">

		<!-- Grote CTA -->
		<div
			class="group relative overflow-hidden rounded-3xl border border-[#d4af37]/25 bg-[#111111] p-8 shadow-2xl sm:p-10 lg:p-12"
		>
			<div
				class="absolute right-0 top-0 h-72 w-72 rounded-full bg-[#d4af37]/10 blur-[110px]"
			></div>

			<div
				class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#d4af37]/70 to-transparent"
			></div>

			<div
				class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
			>
				<div class="max-w-3xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						U heeft een idee?
					</p>

					<h2
						class="mt-5 text-3xl font-black leading-tight tracking-[-0.045em] text-white sm:text-4xl lg:text-5xl"
					>
						Van betere WiFi tot een volledige
						<span class="text-[#d4af37]"> slimme woning.</span>
					</h2>

					<p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">
						Wij denken met u mee, kiezen de juiste oplossing en zorgen voor
						een nette installatie, configuratie en duidelijke uitleg.
					</p>
				</div>

				<a
					href="/#contact"
					class="group/cta inline-flex min-h-14 shrink-0 items-center justify-center gap-3 rounded-lg bg-[#d4af37] px-8 font-black text-black outline-none transition duration-300 hover:-translate-y-1 hover:bg-white focus-visible:ring-2 focus-visible:ring-white"
				>
					<FileText
						size={20}
						strokeWidth={2.2}
						aria-hidden="true"
						class="transition duration-300 group-hover/cta:-rotate-3 group-hover/cta:scale-105"
					/>

					Vraag vrijblijvend een offerte aan
				</a>
			</div>
		</div>

		<!-- Hoofdfooter -->
		<div class="mt-16 grid gap-14 md:grid-cols-2 lg:grid-cols-6">

			<!-- Branding -->
			<div class="md:col-span-2 lg:col-span-2">
				<a
					href="/"
					class="inline-flex items-center gap-2 rounded-lg text-2xl font-black outline-none focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
					aria-label="VeYo Smart Solutions homepage"
				>
					<span class="text-[#d4af37]">VeYo</span>
					<span class="text-white">Smart Solutions</span>
				</a>

				<p class="mt-5 text-xl font-bold text-white">
					Slimmer wonen.
					<span class="text-[#d4af37]"> Beter leven.</span>
				</p>

				<p class="mt-5 max-w-md leading-7 text-neutral-400">
					Slimme oplossingen op maat voor woningen en kleine ondernemingen.
					Van advies en bekabeling tot installatie, configuratie en nazorg.
				</p>

				<ul class="mt-7 grid gap-3 sm:grid-cols-2">
					{
						strengths.map(({ icon: Icon, text }) => (
							<li
								class="group flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 transition duration-300 hover:-translate-y-0.5 hover:border-[#d4af37]/35 hover:bg-white/[0.045]"
							>
								<span
									class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d4af37]/35 bg-[#d4af37]/10 text-[#d4af37] transition duration-300 group-hover:scale-105 group-hover:border-[#d4af37]/55"
									aria-hidden="true"
								>
									<Icon
										size={18}
										strokeWidth={2}
										class="transition duration-300 group-hover:scale-110"
									/>
								</span>

								<span class="text-sm leading-5 text-neutral-300">
									{text}
								</span>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Snelle links -->
			<div>
				<h2
					class="text-sm font-bold uppercase tracking-[0.2em] text-[#d4af37]"
				>
					Snelle links
				</h2>

				<ul class="mt-6 space-y-3">
					{
						quickLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="group inline-flex items-center gap-2 rounded-md text-neutral-400 outline-none transition hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
								>
									<span>{link.label}</span>

									<ArrowRight
										size={15}
										strokeWidth={2}
										aria-hidden="true"
										class="translate-x-0 text-[#d4af37] opacity-0 transition duration-300 group-hover:translate-x-1 group-hover:opacity-100"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Diensten -->
			<div>
				<h2
					class="text-sm font-bold uppercase tracking-[0.2em] text-[#d4af37]"
				>
					Diensten
				</h2>

				<ul class="mt-6 space-y-3">
					{
						services.map((service) => (
							<li>
								<a
									href="/#diensten"
									class="rounded-md text-neutral-400 outline-none transition hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
								>
									{service}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Contact -->
			<div class="md:col-span-2 lg:col-span-2">
				<h2
					class="text-sm font-bold uppercase tracking-[0.2em] text-[#d4af37]"
				>
					Contact
				</h2>

				<div class="mt-6 space-y-3">
					<a
						href="tel:+32456536037"
						class="group flex items-center gap-3 rounded-xl p-2 text-neutral-400 outline-none transition hover:bg-white/[0.04] hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
					>
						<span
							class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
							aria-hidden="true"
						>
							<Phone size={18} strokeWidth={2} />
						</span>

						<span class="whitespace-nowrap">
							+32 456 53 60 37
						</span>
					</a>

					<a
						href="mailto:info@veyosmartsolutions.com"
						class="group flex items-center gap-3 rounded-xl p-2 text-neutral-400 outline-none transition hover:bg-white/[0.04] hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
					>
						<span
							class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
							aria-hidden="true"
						>
							<Mail size={18} strokeWidth={2} />
						</span>

						<span class="whitespace-nowrap text-[13px] sm:text-sm xl:text-base">
							info@veyosmartsolutions.com
						</span>
					</a>

					<div class="flex items-start gap-3 rounded-xl p-2 text-neutral-400">
						<span
							class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
							aria-hidden="true"
						>
							<MapPin size={18} strokeWidth={2} />
						</span>

						<div class="leading-6">
							<p>Actief op locatie</p>
							<p>West- & Oost-Vlaanderen</p>
						</div>
					</div>

					<div class="flex items-start gap-3 rounded-xl p-2 text-neutral-400">
						<span
							class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
							aria-hidden="true"
						>
							<ReceiptText size={18} strokeWidth={2} />
						</span>

						<div class="leading-6">
							<p>BTW-nummer</p>
							<p>BE1037811809</p>
						</div>
					</div>
				</div>

				<!-- Sociale media -->
				<div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
					{
						socialLinks.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${social.name} van VeYo Smart Solutions openen`}
								class="group inline-flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-neutral-300 outline-none transition duration-300 hover:-translate-y-0.5 hover:border-[#d4af37]/50 hover:bg-white/[0.05] hover:text-[#d4af37] focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
							>
								<span>{social.name}</span>

								<ExternalLink
									size={17}
									strokeWidth={2}
									aria-hidden="true"
									class="transition duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
								/>
							</a>
						))
					}
				</div>
			</div>
		</div>

		<!-- Onderste lijn -->
		<div
			class="mt-16 flex flex-col gap-5 border-t border-white/10 pt-8 text-sm text-neutral-500 lg:flex-row lg:items-center lg:justify-between"
		>
			<div>
				<p>
					© {currentYear} VeYo Smart Solutions. Alle rechten voorbehouden.
				</p>

				<p class="mt-2 text-xs text-neutral-600">
					Website ontworpen en ontwikkeld door VeYo Smart Solutions.
				</p>
			</div>

			<div class="flex flex-wrap gap-x-6 gap-y-2">
				<a
					href="/privacy"
					class="rounded-md outline-none transition hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
				>
					Privacybeleid
				</a>

				<a
					href="/cookiebeleid"
					class="rounded-md outline-none transition hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
				>
					Cookiebeleid
				</a>

				<a
					href="/algemene-voorwaarden"
					class="rounded-md outline-none transition hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
				>
					Algemene voorwaarden
				</a>
			</div>
		</div>
	</div>
</footer>