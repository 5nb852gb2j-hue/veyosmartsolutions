---
import {
	FileText,
	MessageCircle,
	ChevronDown,
	House,
	Wifi,
	Lightbulb,
	Zap,
	Speaker,
} from "lucide-astro";

const navigation = [
	{ label: "Projecten", href: "/#projecten" },
	{ label: "Merken", href: "/#merken" },
	{ label: "FAQ", href: "/#faq" },
	{ label: "Over VeYo", href: "/#over-veyo" },
	{ label: "Contact", href: "/#contact" },
];

const serviceLinks = [
	{
		label: "Smart home & automatisatie",
		href: "/smart-home",
		icon: House,
	},
	{
		label: "WiFi & netwerken",
		href: "/wifi-netwerken",
		icon: Wifi,
	},
	{
		label: "Slimme verlichting",
		href: "/slimme-verlichting",
		icon: Lightbulb,
	},
	{
		label: "Energie & klimaat",
		href: "/energie-klimaat",
		icon: Zap,
	},
	{
		label: "Audio & home cinema",
		href: "/audio-home-cinema",
		icon: Speaker,
	},
];
---

<header
	class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#080808]/85 shadow-[0_12px_35px_rgba(0,0,0,0.22)] backdrop-blur-xl"
>
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="flex h-20 items-center justify-between gap-6">

			<!-- Logo -->
			<a
				href="/"
				class="group inline-flex shrink-0 items-center gap-2 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-[#d4af37]/70"
				aria-label="VeYo Smart Solutions homepage"
			>
				<span
					class="text-2xl font-black tracking-[-0.04em] text-[#d4af37] transition duration-300 group-hover:text-white"
				>
					VeYo
				</span>

				<span
					class="hidden text-lg font-bold tracking-[-0.025em] text-white sm:inline"
				>
					Smart Solutions
				</span>
			</a>

			<!-- Desktopnavigatie -->
			<nav
				class="hidden items-center gap-7 lg:flex"
				aria-label="Hoofdnavigatie"
			>
				<!-- Diensten dropdown -->
				<div class="group/services relative">
					<a
						href="/#diensten"
						class="flex items-center gap-1.5 rounded-md py-7 text-sm font-bold text-neutral-300 outline-none transition duration-300 hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
					>
						Diensten

						<ChevronDown
							size={16}
							strokeWidth={2.2}
							aria-hidden="true"
							class="transition duration-300 group-hover/services:rotate-180"
						/>
					</a>

					<div
						class="pointer-events-none absolute left-0 top-full w-[340px] translate-y-2 rounded-2xl border border-white/10 bg-[#101010]/98 p-3 opacity-0 shadow-2xl backdrop-blur-xl transition duration-200 group-hover/services:pointer-events-auto group-hover/services:translate-y-0 group-hover/services:opacity-100"
					>
						<div class="space-y-1">
							{
								serviceLinks.map(({ label, href, icon: Icon }) => (
									<a
										href={href}
										class="group/item flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-bold text-neutral-300 transition duration-300 hover:bg-white/[0.05] hover:text-[#d4af37]"
									>
										<span
											class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d4af37]/25 bg-[#d4af37]/10 text-[#d4af37]"
											aria-hidden="true"
										>
											<Icon size={18} strokeWidth={2} />
										</span>

										<span>{label}</span>
									</a>
								))
							}
						</div>

						<a
							href="/#diensten"
							class="mt-2 flex items-center justify-center rounded-xl border border-white/10 px-4 py-3 text-sm font-bold text-neutral-400 transition hover:border-[#d4af37]/40 hover:text-white"
						>
							Bekijk alle oplossingen
						</a>
					</div>
				</div>

				{
					navigation.map((item) => (
						<a
							href={item.href}
							class="group relative rounded-md py-7 text-sm font-bold text-neutral-300 outline-none transition duration-300 hover:text-white focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
						>
							{item.label}

							<span
								class="absolute inset-x-0 bottom-5 h-px origin-left scale-x-0 bg-[#d4af37] transition duration-300 group-hover:scale-x-100"
								aria-hidden="true"
							></span>
						</a>
					))
				}
			</nav>

			<!-- Desktop CTA -->
			<a
				href="/#contact"
				class="group hidden min-h-12 shrink-0 items-center justify-center gap-2.5 rounded-lg bg-[#d4af37] px-6 text-sm font-black text-black outline-none transition duration-300 hover:-translate-y-0.5 hover:bg-white focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#080808] lg:inline-flex"
			>
				<FileText
					size={18}
					strokeWidth={2.2}
					aria-hidden="true"
					class="transition duration-300 group-hover:-rotate-3 group-hover:scale-105"
				/>

				Offerte aanvragen
			</a>

			<!-- Mobiel menu -->
			<details class="group relative lg:hidden">
				<summary
					class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] text-white outline-none transition duration-300 hover:border-[#d4af37]/50 hover:bg-white/[0.06] hover:text-[#d4af37] focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
					aria-label="Open navigatiemenu"
				>
					<span class="relative block h-5 w-6" aria-hidden="true">
						<span
							class="absolute left-0 top-0 h-0.5 w-6 bg-current transition duration-300 group-open:top-[9px] group-open:rotate-45"
						></span>

						<span
							class="absolute left-0 top-[9px] h-0.5 w-6 bg-current transition duration-300 group-open:opacity-0"
						></span>

						<span
							class="absolute bottom-0 left-0 h-0.5 w-6 bg-current transition duration-300 group-open:bottom-[9px] group-open:-rotate-45"
						></span>
					</span>
				</summary>

				<div
					class="absolute right-0 top-16 max-h-[75vh] w-[min(88vw,360px)] overflow-y-auto rounded-2xl border border-white/10 bg-[#101010]/95 p-3 shadow-2xl backdrop-blur-xl"
				>
					<nav class="flex flex-col" aria-label="Mobiele navigatie">

						<a
							href="/#diensten"
							class="rounded-xl px-4 py-3.5 font-black text-white transition hover:bg-white/[0.05] hover:text-[#d4af37]"
						>
							Diensten
						</a>

						<div class="mb-2 ml-2 border-l border-[#d4af37]/20 pl-2">
							{
								serviceLinks.map(({ label, href, icon: Icon }) => (
									<a
										href={href}
										class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-bold text-neutral-400 transition hover:bg-white/[0.05] hover:text-[#d4af37]"
									>
										<Icon
											size={17}
											strokeWidth={2}
											aria-hidden="true"
											class="shrink-0 text-[#d4af37]"
										/>

										<span>{label}</span>
									</a>
								))
							}
						</div>

						{
							navigation.map((item) => (
								<a
									href={item.href}
									class="rounded-xl px-4 py-3.5 font-bold text-neutral-300 outline-none transition duration-300 hover:bg-white/[0.05] hover:text-[#d4af37] focus-visible:ring-2 focus-visible:ring-[#d4af37]/60"
								>
									{item.label}
								</a>
							))
						}

						<a
							href="/#contact"
							class="group mt-3 inline-flex min-h-12 items-center justify-center gap-2.5 rounded-lg bg-[#d4af37] px-5 font-black text-black outline-none transition duration-300 hover:bg-white focus-visible:ring-2 focus-visible:ring-white"
						>
							<FileText
								size={18}
								strokeWidth={2.2}
								aria-hidden="true"
							/>

							Offerte aanvragen
						</a>

						<a
							href="https://wa.me/32456536037?text=Hallo%20Yordi%2C%20ik%20heb%20interesse%20in%20een%20slimme%20oplossing%20van%20VeYo%20Smart%20Solutions."
							target="_blank"
							rel="noopener noreferrer"
							class="group mt-3 inline-flex min-h-12 items-center justify-center gap-2.5 rounded-lg border border-[#25D366]/40 px-5 font-bold text-[#25D366] outline-none transition duration-300 hover:border-[#25D366] hover:bg-[#25D366] hover:text-black focus-visible:ring-2 focus-visible:ring-[#25D366]/70"
						>
							<MessageCircle
								size={19}
								strokeWidth={2.2}
								aria-hidden="true"
								class="transition duration-300 group-hover:scale-110"
							/>

							WhatsApp
						</a>
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>