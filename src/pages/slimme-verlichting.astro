---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

import {
	Lightbulb,
	Sun,
	Timer,
	Smartphone,
	Move,
	House,
	Check,
	ArrowRight,
	Sparkles,
	Zap,
	SlidersHorizontal,
} from "lucide-astro";

const title =
	"Slimme Verlichting Jabbeke & West-Vlaanderen | VeYo Smart Solutions";

const description =
	"VeYo Smart Solutions installeert slimme verlichting voor binnen en buiten in Jabbeke en West-Vlaanderen. Bedien verlichting via app, sensoren, automatisaties, tijdschema's en smart home.";

const solutions = [
	{
		icon: House,
		title: "Slimme verlichting in huis",
		description:
			"Maak bestaande of nieuwe verlichting slim en bedien verschillende ruimtes eenvoudig vanuit één gebruiksvriendelijke omgeving.",
	},
	{
		icon: Sun,
		title: "Buitenverlichting",
		description:
			"Automatiseer verlichting aan uw woning, terras, tuin, oprit of carport op basis van tijd, beweging of andere voorwaarden.",
	},
	{
		icon: Move,
		title: "Bewegingssensoren",
		description:
			"Laat verlichting automatisch inschakelen wanneer iemand een ruimte betreedt en opnieuw uitschakelen wanneer ze niet meer nodig is.",
	},
	{
		icon: Timer,
		title: "Tijdschema's & automatisaties",
		description:
			"Verlichting kan automatisch reageren op tijdstippen, zonsondergang, aanwezigheid of andere slimme apparaten in uw woning.",
	},
	{
		icon: Smartphone,
		title: "Bediening via app",
		description:
			"Bedien verlichting vanaf uw smartphone en behoud tegelijk een praktische bediening in de woning zelf.",
	},
	{
		icon: SlidersHorizontal,
		title: "Sferen & scènes",
		description:
			"Combineer verschillende lampen in scènes voor bijvoorbeeld ontspannen, televisie kijken, thuiskomen of sfeervolle buitenverlichting.",
	},
];

const possibilities = [
	"Automatisch licht bij beweging",
	"Verlichting laten reageren op zonsondergang",
	"Meerdere lampen tegelijk bedienen",
	"Vaste tijdschema's instellen",
	"Sferen en scènes creëren",
	"Verlichting koppelen aan uw smart home",
	"Bestaande bediening behouden waar mogelijk",
	"Later eenvoudig verder uitbreiden",
];

const steps = [
	{
		number: "01",
		title: "Uw wensen bespreken",
		description:
			"We bekijken welke verlichting u slim wilt maken en hoe u die dagelijks wilt gebruiken.",
	},
	{
		number: "02",
		title: "Geschikte oplossing kiezen",
		description:
			"We bepalen welke slimme schakelaars, modules, lampen of sensoren het beste bij uw bestaande installatie passen.",
	},
	{
		number: "03",
		title: "Installeren & configureren",
		description:
			"De gekozen oplossing wordt netjes geïnstalleerd, gekoppeld en ingesteld volgens uw wensen.",
	},
	{
		number: "04",
		title: "Automatiseren & uitleg",
		description:
			"We stellen de gewenste automatisaties in en leggen duidelijk uit hoe u alles zelf kunt bedienen.",
	},
];
---

<Layout title={title} description={description}>
	<Header />

	<main>
		<!-- HERO -->
		<section
			class="relative overflow-hidden bg-[#090909] pb-24 pt-36 sm:pb-28 sm:pt-40 lg:pb-32 lg:pt-44"
		>
			<div
				class="absolute right-[-180px] top-[-120px] h-[600px] w-[600px] rounded-full bg-[#d4af37]/10 blur-[170px]"
			></div>

			<div
				class="absolute left-[-220px] bottom-[-260px] h-[500px] w-[500px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-4xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Slimme verlichting • Jabbeke & West-Vlaanderen
					</p>

					<h1
						class="mt-6 text-5xl font-black leading-[0.98] tracking-[-0.055em] text-white sm:text-6xl lg:text-7xl xl:text-8xl"
					>
						Verlichting die meedenkt.
						<span class="block text-[#d4af37]">
							Comfort op het juiste moment.
						</span>
					</h1>

					<p
						class="mt-8 max-w-3xl text-lg leading-8 text-neutral-300 sm:text-xl"
					>
						Bedien uw verlichting via app, schakelaars, sensoren of volledig
						automatisch. VeYo Smart Solutions installeert slimme verlichting
						voor binnen en buiten, afgestemd op uw woning en dagelijks gebruik.
					</p>

					<div class="mt-10 flex flex-col gap-4 sm:flex-row">
						<a
							href="#verlichting-contact"
							class="inline-flex min-h-14 items-center justify-center gap-2 rounded-lg bg-[#d4af37] px-7 font-black text-black transition duration-300 hover:-translate-y-1 hover:bg-white"
						>
							Bespreek uw verlichting
							<ArrowRight size={19} strokeWidth={2.3} />
						</a>

						<a
							href="#mogelijkheden"
							class="inline-flex min-h-14 items-center justify-center rounded-lg border border-white/15 px-7 font-bold text-white transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37]"
						>
							Ontdek de mogelijkheden
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- INTRO -->
		<section class="relative bg-[#0d0d0d] py-24 sm:py-32">
			<div
				class="absolute left-1/2 top-0 h-px w-[80%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#d4af37]/40 to-transparent"
			></div>

			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-20"
				>
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
						>
							Meer dan aan en uit
						</p>

						<h2
							class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl"
						>
							De juiste verlichting,
							<span class="block text-[#d4af37]">
								zonder erover na te denken.
							</span>
						</h2>
					</div>

					<div>
						<p class="text-lg leading-8 text-neutral-400">
							Slimme verlichting draait niet alleen om een lamp bedienen
							met uw smartphone. Een goede installatie zorgt ervoor dat
							verlichting vanzelf reageert wanneer dat nuttig is, terwijl
							handmatige bediening eenvoudig blijft.
						</p>

						<p class="mt-5 text-lg leading-8 text-neutral-400">
							Zo kan verlichting automatisch inschakelen wanneer u
							thuiskomt, reageren op beweging, meegaan met zonsondergang of
							samenwerken met andere slimme apparaten in uw woning.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- MOGELIJKHEDEN -->
		<section
			id="mogelijkheden"
			class="relative overflow-hidden bg-[#090909] py-24 sm:py-32"
		>
			<div
				class="absolute -right-40 top-24 h-[480px] w-[480px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Mogelijkheden
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
					>
						Slimme verlichting voor
						<span class="text-[#d4af37]"> elke ruimte.</span>
					</h2>

					<p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">
						Van één lichtpunt tot meerdere ruimtes: we zoeken een oplossing
						die aansluit bij uw bestaande installatie, wensen en budget.
					</p>
				</div>

				<div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
					{
						solutions.map(({ icon: Icon, title, description }) => (
							<article
								class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#d4af37]/55 hover:bg-white/[0.055]"
							>
								<div
									class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#d4af37]/0 to-transparent transition duration-300 group-hover:via-[#d4af37]/80"
								></div>

								<div
									class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
									aria-hidden="true"
								>
									<Icon
										size={27}
										strokeWidth={2}
										class="transition duration-300 group-hover:scale-110"
									/>
								</div>

								<h3 class="mt-6 text-xl font-black text-white">
									{title}
								</h3>

								<p class="mt-3 leading-7 text-neutral-400">
									{description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- AUTOMATISATIES -->
		<section class="relative bg-[#0d0d0d] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
						>
							Slim automatiseren
						</p>

						<h2
							class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl"
						>
							U bepaalt wanneer.
							<span class="block text-[#d4af37]">
								Uw woning doet de rest.
							</span>
						</h2>

						<p class="mt-7 text-lg leading-8 text-neutral-400">
							We kunnen verlichting laten reageren op verschillende
							voorwaarden en gebeurtenissen. Zo krijgt u meer comfort zonder
							dat de bediening ingewikkelder wordt.
						</p>
					</div>

					<ul class="grid gap-4 sm:grid-cols-2">
						{
							possibilities.map((possibility) => (
								<li
									class="flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5"
								>
									<span
										class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
										aria-hidden="true"
									>
										<Check size={17} strokeWidth={2.5} />
									</span>

									<span class="leading-7 text-neutral-300">
										{possibility}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- WERKWIJZE -->
		<section class="relative overflow-hidden bg-[#090909] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="mx-auto max-w-3xl text-center">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Van idee tot automatisatie
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
					>
						Zo maken we uw
						<span class="text-[#d4af37]"> verlichting slim.</span>
					</h2>
				</div>

				<div class="mt-16 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
					{
						steps.map((step) => (
							<article
								class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-7"
							>
								<p
									class="text-4xl font-black tracking-[-0.05em] text-[#d4af37]/35"
								>
									{step.number}
								</p>

								<h3 class="mt-5 text-xl font-black text-white">
									{step.title}
								</h3>

								<p class="mt-3 leading-7 text-neutral-400">
									{step.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- REALISATIES -->
		<section class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32">
			<div
				class="absolute -left-40 top-20 h-[460px] w-[460px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Onze realisaties
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl"
					>
						Bekijk slimme verlichting
						<span class="text-[#d4af37]"> in de praktijk.</span>
					</h2>
				</div>

				<div class="mt-12 grid gap-6 lg:grid-cols-2">
					<a
						href="/projects/smart-lighting"
						class="group relative min-h-[380px] overflow-hidden rounded-2xl border border-white/10 bg-[#111111] transition duration-300 hover:-translate-y-1 hover:border-[#d4af37]/50"
					>
						<img
							src="/images/projects/smart-lighting/hero.jpeg"
							alt="Slimme verlichting geïnstalleerd door VeYo Smart Solutions"
							loading="lazy"
							class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
						/>

						<div
							class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent"
						></div>

						<div class="absolute inset-x-0 bottom-0 p-7 sm:p-8">
							<p
								class="text-sm font-bold uppercase tracking-[0.18em] text-[#d4af37]"
							>
								Slimme verlichting
							</p>

							<h3 class="mt-3 text-2xl font-black text-white sm:text-3xl">
								Slimme verlichting binnen en buiten
							</h3>

							<p class="mt-4 font-bold text-[#d4af37]">
								Bekijk realisatie →
							</p>
						</div>
					</a>

					<a
						href="/projects/carport-lighting"
						class="group relative min-h-[380px] overflow-hidden rounded-2xl border border-white/10 bg-[#111111] transition duration-300 hover:-translate-y-1 hover:border-[#d4af37]/50"
					>
						<img
							src="/images/projects/carport-lighting/hero.jpeg"
							alt="Slimme carportverlichting geïnstalleerd door VeYo Smart Solutions"
							loading="lazy"
							class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
						/>

						<div
							class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent"
						></div>

						<div class="absolute inset-x-0 bottom-0 p-7 sm:p-8">
							<p
								class="text-sm font-bold uppercase tracking-[0.18em] text-[#d4af37]"
							>
								Buitenverlichting
							</p>

							<h3 class="mt-3 text-2xl font-black text-white sm:text-3xl">
								Slimme carportverlichting
							</h3>

							<p class="mt-4 font-bold text-[#d4af37]">
								Bekijk realisatie →
							</p>
						</div>
					</a>
				</div>
			</div>
		</section>

		<!-- MERKONAFHANKELIJK -->
		<section class="relative bg-[#090909] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="relative overflow-hidden rounded-3xl border border-[#d4af37]/25 bg-[#111111] p-8 sm:p-10 lg:p-12"
				>
					<div
						class="absolute right-0 top-0 h-80 w-80 rounded-full bg-[#d4af37]/10 blur-[120px]"
					></div>

					<div
						class="relative grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-center"
					>
						<div
							class="flex h-20 w-20 items-center justify-center rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
						>
							<Sparkles size={38} strokeWidth={1.8} />
						</div>

						<div>
							<p
								class="text-sm font-bold uppercase tracking-[0.22em] text-[#d4af37]"
							>
								Passend bij uw installatie
							</p>

							<h2
								class="mt-4 text-3xl font-black tracking-[-0.04em] text-white sm:text-4xl"
							>
								Niet zomaar slimme lampen plaatsen.
							</h2>

							<p
								class="mt-5 max-w-3xl text-lg leading-8 text-neutral-400"
							>
								We bekijken welke oplossing technisch en praktisch het beste
								past. Waar mogelijk houden we rekening met bestaande
								schakelaars, armaturen en smart-homeapparatuur, zodat de
								installatie logisch blijft werken voor iedereen in huis.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section
			id="verlichting-contact"
			class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32"
		>
			<div
				class="absolute left-1/2 top-1/2 h-[550px] w-[550px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#d4af37]/8 blur-[170px]"
			></div>

			<div class="relative mx-auto max-w-5xl px-6 text-center lg:px-8">
				<div
					class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
				>
					<Lightbulb size={27} strokeWidth={2} />
				</div>

				<p
					class="mt-7 text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
				>
					Maak uw verlichting slim
				</p>

				<h2
					class="mx-auto mt-5 max-w-4xl text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
				>
					Klaar voor verlichting die
					<span class="text-[#d4af37]"> met u meedenkt?</span>
				</h2>

				<p
					class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-neutral-400"
				>
					Vertel ons wat u wilt automatiseren. We bekijken welke oplossing
					past bij uw bestaande installatie, woning en manier van leven.
				</p>

				<div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
					<a
						href="/#contact"
						class="inline-flex min-h-14 items-center justify-center gap-2 rounded-lg bg-[#d4af37] px-8 font-black text-black transition duration-300 hover:-translate-y-1 hover:bg-white"
					>
						Vraag vrijblijvend advies
						<ArrowRight size={19} strokeWidth={2.3} />
					</a>

					<a
						href="/#projecten"
						class="inline-flex min-h-14 items-center justify-center rounded-lg border border-white/15 px-8 font-bold text-white transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37]"
					>
						Bekijk onze realisaties
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>