---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

import {
	Speaker,
	Tv,
	Radio,
	Volume2,
	House,
	Smartphone,
	Check,
	ArrowRight,
	Music2,
	Settings,
} from "lucide-astro";

const title =
	"Audio & Home Cinema Jabbeke | VeYo Smart Solutions";

const description =
	"VeYo Smart Solutions installeert multiroom audio, Sonos, tv-audio en home cinema in Jabbeke en West-Vlaanderen. Professionele plaatsing, configuratie en duidelijke bediening.";

const solutions = [
	{
		icon: Speaker,
		title: "Multiroom audio",
		description:
			"Luister in meerdere ruimtes naar dezelfde muziek of kies per kamer afzonderlijke audio, volledig centraal bedienbaar.",
	},
	{
		icon: Tv,
		title: "TV-audio",
		description:
			"Verbeter de geluidskwaliteit van uw televisie met een oplossing die past bij uw ruimte, interieur en kijkgewoonten.",
	},
	{
		icon: Volume2,
		title: "Surround & home cinema",
		description:
			"Creëer een meeslepende film- en muziekervaring met zorgvuldig geplaatste luidsprekers en een correct geconfigureerde opstelling.",
	},
	{
		icon: Music2,
		title: "Muziek in elke ruimte",
		description:
			"Van woonkamer en keuken tot terras: muziek waar u wilt, zonder ingewikkelde bediening.",
	},
	{
		icon: Smartphone,
		title: "Eenvoudige bediening",
		description:
			"Bedien audio eenvoudig via app, afstandsbediening of gekoppelde smart home-oplossingen.",
	},
	{
		icon: House,
		title: "Integratie in uw woning",
		description:
			"We houden rekening met uw bestaande televisie, netwerk, interieur en slimme systemen voor een nette en logische totaaloplossing.",
	},
];

const benefits = [
	"Advies afgestemd op ruimte en gebruik",
	"Nette plaatsing en configuratie",
	"Geschikt voor muziek, tv en film",
	"Multiroom mogelijk in meerdere ruimtes",
	"Eenvoudige bediening via app of smart home",
	"Mogelijkheid om later uit te breiden",
];

const steps = [
	{
		number: "01",
		title: "Uw wensen bespreken",
		description:
			"We bekijken waar u audio wilt, waarvoor u het systeem gebruikt en welke apparatuur al aanwezig is.",
	},
	{
		number: "02",
		title: "Oplossing samenstellen",
		description:
			"We bepalen welke luidsprekers, soundbars of andere audiocomponenten passen bij uw ruimte en verwachtingen.",
	},
	{
		number: "03",
		title: "Installatie & configuratie",
		description:
			"We plaatsen en configureren de apparatuur en zorgen dat alles correct verbonden en ingesteld is.",
	},
	{
		number: "04",
		title: "Testen & uitleg",
		description:
			"Na de installatie testen we het systeem en leggen we duidelijk uit hoe u alles eenvoudig kunt bedienen.",
	},
];
---

<Layout title={title} description={description}>
	<Header />

	<main>
		<!-- HERO -->
		<section
			class="relative overflow-hidden bg-[#090909] pb-24 pt-36 sm:pb-28 sm:pt-40 lg:pb-32 lg:pt-44"
		>
			<div
				class="absolute right-[-180px] top-[-120px] h-[600px] w-[600px] rounded-full bg-[#d4af37]/10 blur-[170px]"
			></div>

			<div
				class="absolute left-[-250px] bottom-[-250px] h-[500px] w-[500px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-4xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Audio & home cinema • Jabbeke & West-Vlaanderen
					</p>

					<h1
						class="mt-6 text-5xl font-black leading-[0.98] tracking-[-0.055em] text-white sm:text-6xl lg:text-7xl xl:text-8xl"
					>
						Audio die u voelt.
						<span class="block text-[#d4af37]">
							Perfect afgestemd op uw woning.
						</span>
					</h1>

					<p
						class="mt-8 max-w-3xl text-lg leading-8 text-neutral-300 sm:text-xl"
					>
						VeYo Smart Solutions installeert en configureert audio-oplossingen
						voor woningen en kleine bedrijven. Van multiroom audio en
						tv-geluid tot surround en home cinema.
					</p>

					<div class="mt-10 flex flex-col gap-4 sm:flex-row">
						<a
							href="#audio-contact"
							class="inline-flex min-h-14 items-center justify-center gap-2 rounded-lg bg-[#d4af37] px-7 font-black text-black transition duration-300 hover:-translate-y-1 hover:bg-white"
						>
							Bespreek uw audio-oplossing
							<ArrowRight size={19} strokeWidth={2.3} />
						</a>

						<a
							href="#mogelijkheden"
							class="inline-flex min-h-14 items-center justify-center rounded-lg border border-white/15 px-7 font-bold text-white transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37]"
						>
							Ontdek de mogelijkheden
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- INTRO -->
		<section class="relative bg-[#0d0d0d] py-24 sm:py-32">
			<div
				class="absolute left-1/2 top-0 h-px w-[80%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#d4af37]/40 to-transparent"
			></div>

			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-20"
				>
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
						>
							Muziek en film, zonder gedoe
						</p>

						<h2
							class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl"
						>
							Goed geluid begint bij
							<span class="block text-[#d4af37]">
								de juiste opstelling.
							</span>
						</h2>
					</div>

					<div>
						<p class="text-lg leading-8 text-neutral-400">
							Een goed audiosysteem draait niet alleen om krachtige
							luidsprekers. De ruimte, plaatsing, verbindingen en configuratie
							bepalen mee hoe het eindresultaat klinkt.
						</p>

						<p class="mt-5 text-lg leading-8 text-neutral-400">
							Daarom bekijken we hoe u muziek en televisie gebruikt en
							bouwen we een oplossing die praktisch blijft in dagelijks
							gebruik, netjes geïntegreerd is en later kan meegroeien.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- MOGELIJKHEDEN -->
		<section
			id="mogelijkheden"
			class="relative overflow-hidden bg-[#090909] py-24 sm:py-32"
		>
			<div
				class="absolute -right-40 top-24 h-[480px] w-[480px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Audio-oplossingen
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
					>
						Van achtergrondmuziek tot
						<span class="text-[#d4af37]"> volledige home cinema.</span>
					</h2>

					<p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">
						We zoeken naar een oplossing die past bij uw woning, ruimte,
						budget en manier van luisteren.
					</p>
				</div>

				<div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
					{
						solutions.map(({ icon: Icon, title, description }) => (
							<article
								class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#d4af37]/55 hover:bg-white/[0.055]"
							>
								<div
									class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#d4af37]/0 to-transparent transition duration-300 group-hover:via-[#d4af37]/80"
								></div>

								<div
									class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
									aria-hidden="true"
								>
									<Icon
										size={27}
										strokeWidth={2}
										class="transition duration-300 group-hover:scale-110"
									/>
								</div>

								<h3 class="mt-6 text-xl font-black text-white">
									{title}
								</h3>

								<p class="mt-3 leading-7 text-neutral-400">
									{description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- WAAROM -->
		<section class="relative bg-[#0d0d0d] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
						>
							Geluid op maat
						</p>

						<h2
							class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl"
						>
							Geen losse toestellen.
							<span class="block text-[#d4af37]">
								Wel één logisch systeem.
							</span>
						</h2>

						<p class="mt-7 text-lg leading-8 text-neutral-400">
							We kijken naar het volledige plaatje: ruimte, televisie,
							netwerk, bestaande apparatuur en uw verwachtingen. Zo blijft
							de installatie eenvoudig te gebruiken en netjes geïntegreerd.
						</p>
					</div>

					<ul class="grid gap-4 sm:grid-cols-2">
						{
							benefits.map((benefit) => (
								<li
									class="flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5"
								>
									<span
										class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
										aria-hidden="true"
									>
										<Check size={17} strokeWidth={2.5} />
									</span>

									<span class="leading-7 text-neutral-300">
										{benefit}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- WERKWIJZE -->
		<section class="relative overflow-hidden bg-[#090909] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="mx-auto max-w-3xl text-center">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Van idee tot installatie
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
					>
						Zo bouwen we uw
						<span class="text-[#d4af37]"> audio-oplossing.</span>
					</h2>
				</div>

				<div class="mt-16 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
					{
						steps.map((step) => (
							<article
								class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-7"
							>
								<p
									class="text-4xl font-black tracking-[-0.05em] text-[#d4af37]/35"
								>
									{step.number}
								</p>

								<h3 class="mt-5 text-xl font-black text-white">
									{step.title}
								</h3>

								<p class="mt-3 leading-7 text-neutral-400">
									{step.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- REALISATIE -->
		<section class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32">
			<div
				class="absolute -left-40 top-20 h-[460px] w-[460px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Onze realisaties
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl"
					>
						Bekijk audio & home cinema
						<span class="text-[#d4af37]"> in de praktijk.</span>
					</h2>
				</div>

				<a
					href="/projects/sonos-installation"
					class="group relative mt-12 block min-h-[430px] overflow-hidden rounded-2xl border border-white/10 bg-[#111111] transition duration-300 hover:-translate-y-1 hover:border-[#d4af37]/50"
				>
					<img
						src="/images/projects/sonos/hero.jpeg"
						alt="Sonos home cinema installatie door VeYo Smart Solutions"
						loading="lazy"
						class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
					/>

					<div
						class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent"
					></div>

					<div class="absolute inset-x-0 bottom-0 p-7 sm:p-8">
						<p
							class="text-sm font-bold uppercase tracking-[0.18em] text-[#d4af37]"
						>
							Audio & home cinema
						</p>

						<h3 class="mt-3 text-3xl font-black text-white sm:text-4xl">
							Premium Sonos Home Cinema
						</h3>

						<p class="mt-4 font-bold text-[#d4af37]">
							Bekijk realisatie →
						</p>
					</div>
				</a>
			</div>
		</section>

		<!-- INFO BLOK -->
		<section class="relative bg-[#090909] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="relative overflow-hidden rounded-3xl border border-[#d4af37]/25 bg-[#111111] p-8 sm:p-10 lg:p-12"
				>
					<div
						class="absolute right-0 top-0 h-80 w-80 rounded-full bg-[#d4af37]/10 blur-[120px]"
					></div>

					<div
						class="relative grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-center"
					>
						<div
							class="flex h-20 w-20 items-center justify-center rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
						>
							<Speaker size={38} strokeWidth={1.8} />
						</div>

						<div>
							<p
								class="text-sm font-bold uppercase tracking-[0.22em] text-[#d4af37]"
							>
								Passend bij uw woning
							</p>

							<h2
								class="mt-4 text-3xl font-black tracking-[-0.04em] text-white sm:text-4xl"
							>
								Audio moet goed klinken én eenvoudig werken.
							</h2>

							<p
								class="mt-5 max-w-3xl text-lg leading-8 text-neutral-400"
							>
								Afhankelijk van uw woning en wensen bekijken we welke
								oplossing het beste past. Daarbij houden we rekening met
								ruimte, plaatsing, netwerk, televisie en bestaande
								apparatuur zodat alles als één geheel werkt.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section
			id="audio-contact"
			class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32"
		>
			<div
				class="absolute left-1/2 top-1/2 h-[550px] w-[550px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#d4af37]/8 blur-[170px]"
			></div>

			<div class="relative mx-auto max-w-5xl px-6 text-center lg:px-8">
				<div
					class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
				>
					<Radio size={27} strokeWidth={2} />
				</div>

				<p
					class="mt-7 text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
				>
					Meer uit uw audio halen
				</p>

				<h2
					class="mx-auto mt-5 max-w-4xl text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
				>
					Klaar voor beter geluid
					<span class="text-[#d4af37]"> in uw woning?</span>
				</h2>

				<p
					class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-neutral-400"
				>
					Vertel ons welke ruimte u wilt verbeteren. We bekijken welke
					audio- of home-cinemaoplossing bij uw woning en manier van luisteren past.
				</p>

				<div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
					<a
						href="/#contact"
						class="inline-flex min-h-14 items-center justify-center gap-2 rounded-lg bg-[#d4af37] px-8 font-black text-black transition duration-300 hover:-translate-y-1 hover:bg-white"
					>
						Vraag vrijblijvend advies
						<ArrowRight size={19} strokeWidth={2.3} />
					</a>

					<a
						href="/projects/sonos-installation"
						class="inline-flex min-h-14 items-center justify-center rounded-lg border border-white/15 px-8 font-bold text-white transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37]"
					>
						Bekijk Sonos realisatie
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>