---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Partners from "../components/Partners.astro";
import Faq from "../components/Faq.astro";
import AboutVeyo from "../components/AboutVeyo.astro";
import ContactSection from "../components/ContactSection.astro";

const title =
	"Smart Home, beveiliging en netwerken | VeYo Smart Solutions";

const description =
	"VeYo Smart Solutions installeert smart home, camerabewaking, alarmsystemen, professionele wifi, netwerken, slimme verlichting en audio in West- en Oost-Vlaanderen.";
---

<Layout title={title} description={description}>
	<Header />

	<main>
		<Hero />
		<Services />
		<About />
		<Projects />
		<Partners />
		<Faq />
		<AboutVeyo />
		<ContactSection />
	</main>
</Layout>