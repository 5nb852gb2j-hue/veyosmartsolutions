---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

import {
	Wifi,
	Router,
	Cable,
	Network,
	Building2,
	Gauge,
	Check,
	ArrowRight,
	RadioTower,
	Server,
	Settings,
	House,
} from "lucide-astro";

const title =
	"Professionele WiFi & Netwerken Jabbeke | VeYo Smart Solutions";

const description =
	"Problemen met WiFi of een professioneel netwerk nodig? VeYo Smart Solutions installeert en optimaliseert WiFi, access points, netwerkbekabeling en thuis- en bedrijfsnetwerken in Jabbeke en West-Vlaanderen.";

const solutions = [
	{
		icon: Wifi,
		title: "Sterke WiFi in elke ruimte",
		description:
			"We zorgen voor een stabiele draadloze verbinding op de plaatsen waar u die nodig heeft, ook in grotere woningen of moeilijk bereikbare ruimtes.",
	},
	{
		icon: RadioTower,
		title: "Professionele access points",
		description:
			"Strategisch geplaatste access points zorgen voor betere dekking, capaciteit en een betrouwbare verbinding doorheen uw woning of bedrijf.",
	},
	{
		icon: Cable,
		title: "Netwerkbekabeling",
		description:
			"Waar mogelijk voorzien of gebruiken we bekabelde netwerkverbindingen voor maximale snelheid, stabiliteit en een betrouwbare basis.",
	},
	{
		icon: Network,
		title: "Thuisnetwerken",
		description:
			"Van router en switch tot access points en slimme toestellen: we bouwen een overzichtelijk netwerk dat aansluit bij uw dagelijks gebruik.",
	},
	{
		icon: Building2,
		title: "Netwerken voor kleine bedrijven",
		description:
			"Betrouwbare connectiviteit voor kantoor, handelszaak of andere kleine bedrijfsomgeving, afgestemd op gebruikers en aangesloten apparatuur.",
	},
	{
		icon: Server,
		title: "Netwerkkast & centrale installatie",
		description:
			"We kunnen netwerkapparatuur centraal en netjes installeren zodat bekabeling, switches en andere componenten overzichtelijk samenkomen.",
	},
];

const problems = [
	"WiFi die niet overal in huis geraakt",
	"Trage of instabiele draadloze verbinding",
	"Dode zones op verdieping, terras of in de tuin",
	"Veel slimme toestellen op hetzelfde netwerk",
	"Een verouderde of slecht geplaatste router",
	"Behoefte aan een professioneel en uitbreidbaar netwerk",
];

const steps = [
	{
		number: "01",
		title: "Situatie bekijken",
		description:
			"We bespreken waar de problemen zich voordoen, welke apparatuur aanwezig is en waarvoor het netwerk wordt gebruikt.",
	},
	{
		number: "02",
		title: "Netwerkoplossing bepalen",
		description:
			"We bepalen welke combinatie van router, switches, access points en bekabeling geschikt is voor uw situatie.",
	},
	{
		number: "03",
		title: "Installatie & configuratie",
		description:
			"We plaatsen en configureren de apparatuur en zorgen voor een logisch en betrouwbaar opgebouwd netwerk.",
	},
	{
		number: "04",
		title: "Testen & uitleg",
		description:
			"Na de installatie controleren we de verbinding en krijgt u duidelijke uitleg over de werking van uw nieuwe netwerk.",
	},
];

const benefits = [
	"Advies afgestemd op uw woning of bedrijf",
	"Professionele access points in plaats van onnodige WiFi-versterkers",
	"Bekabelde verbindingen waar dit technisch de beste oplossing is",
	"Netwerk geschikt voor smart home en andere verbonden apparaten",
	"Netjes geïnstalleerd en logisch geconfigureerd",
	"Mogelijkheid om later verder uit te breiden",
];
---

<Layout title={title} description={description}>
	<Header />

	<main>
		<!-- HERO -->
		<section
			class="relative overflow-hidden bg-[#090909] pb-24 pt-36 sm:pb-28 sm:pt-40 lg:pb-32 lg:pt-44"
		>
			<div
				class="absolute right-[-180px] top-[-120px] h-[600px] w-[600px] rounded-full bg-[#d4af37]/10 blur-[170px]"
			></div>

			<div
				class="absolute left-[-250px] bottom-[-250px] h-[500px] w-[500px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-4xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						WiFi & netwerken • Jabbeke & West-Vlaanderen
					</p>

					<h1
	class="mt-6 text-5xl font-black leading-[0.98] tracking-[-0.055em] text-white sm:text-6xl lg:text-7xl xl:text-8xl"
>
	Sterke WiFi.
	<span class="block text-[#d4af37]">
		Een netwerk waarop u kunt rekenen.
	</span>
</h1>
					<p
						class="mt-8 max-w-3xl text-lg leading-8 text-neutral-300 sm:text-xl"
					>
						Geen bereik in bepaalde kamers, een instabiele verbinding of
						een netwerk dat niet meer kan volgen? VeYo Smart Solutions
						ontwerpt, installeert en configureert betrouwbare WiFi- en
						netwerkoplossingen voor woningen en kleine bedrijven.
					</p>

					<div class="mt-10 flex flex-col gap-4 sm:flex-row">
						<a
							href="#wifi-contact"
							class="inline-flex min-h-14 items-center justify-center gap-2 rounded-lg bg-[#d4af37] px-7 font-black text-black transition duration-300 hover:-translate-y-1 hover:bg-white"
						>
							Bespreek uw netwerk
							<ArrowRight size={19} strokeWidth={2.3} />
						</a>

						<a
							href="#mogelijkheden"
							class="inline-flex min-h-14 items-center justify-center rounded-lg border border-white/15 px-7 font-bold text-white transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37]"
						>
							Ontdek de mogelijkheden
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- INTRO -->
		<section class="relative bg-[#0d0d0d] py-24 sm:py-32">
			<div
				class="absolute left-1/2 top-0 h-px w-[80%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#d4af37]/40 to-transparent"
			></div>

			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-20"
				>
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
						>
							De basis van uw digitale woning
						</p>

						<h2
							class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl"
						>
							Goede WiFi begint bij een
							<span class="text-[#d4af37]"> goed netwerk.</span>
						</h2>
					</div>

					<div>
						<p class="text-lg leading-8 text-neutral-400">
							Een snellere internetverbinding lost slechte WiFi niet altijd
							op. De plaats van uw router, bouwmaterialen, afstand,
							netwerkapparatuur en het aantal verbonden toestellen hebben
							allemaal invloed op de kwaliteit van uw verbinding.
						</p>

						<p class="mt-5 text-lg leading-8 text-neutral-400">
							Daarom kijken we verder dan alleen het WiFi-signaal. We
							bekijken het volledige netwerk en zoeken naar een oplossing
							die betrouwbaar werkt voor computers, smartphones, televisies,
							camera's, smart-homeapparatuur en andere verbonden toestellen.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- PROBLEMEN -->
		<section class="relative overflow-hidden bg-[#090909] py-24 sm:py-32">
			<div
				class="absolute -left-40 top-20 h-[460px] w-[460px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
						>
							Herkenbaar?
						</p>

						<h2
							class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl"
						>
							WiFi-problemen hebben vaak een
							<span class="text-[#d4af37]"> duidelijke oorzaak.</span>
						</h2>

						<p class="mt-7 text-lg leading-8 text-neutral-400">
							Een extra versterker plaatsen is niet altijd de juiste
							oplossing. Eerst bepalen we waar het probleem zit en daarna
							bouwen we het netwerk gericht op.
						</p>
					</div>

					<ul class="grid gap-4 sm:grid-cols-2">
						{
							problems.map((problem) => (
								<li
									class="flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5"
								>
									<span
										class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
										aria-hidden="true"
									>
										<Check size={17} strokeWidth={2.5} />
									</span>

									<span class="leading-7 text-neutral-300">
										{problem}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- MOGELIJKHEDEN -->
		<section
			id="mogelijkheden"
			class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32"
		>
			<div
				class="absolute -right-40 top-24 h-[480px] w-[480px] rounded-full bg-[#d4af37]/5 blur-[150px]"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Netwerkoplossingen
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
					>
						Van betere WiFi tot een
						<span class="text-[#d4af37]"> volledig netwerk.</span>
					</h2>

					<p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">
						We bekijken wat uw situatie werkelijk nodig heeft en bouwen
						een oplossing die past bij het aantal gebruikers, toestellen
						en ruimtes.
					</p>
				</div>

				<div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
					{
						solutions.map(({ icon: Icon, title, description }) => (
							<article
								class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#d4af37]/55 hover:bg-white/[0.055]"
							>
								<div
									class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#d4af37]/0 to-transparent transition duration-300 group-hover:via-[#d4af37]/80"
								></div>

								<div
									class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
									aria-hidden="true"
								>
									<Icon
										size={27}
										strokeWidth={2}
										class="transition duration-300 group-hover:scale-110"
									/>
								</div>

								<h3 class="mt-6 text-xl font-black text-white">
									{title}
								</h3>

								<p class="mt-3 leading-7 text-neutral-400">
									{description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- WAAROM PROFESSIONEEL -->
		<section class="relative bg-[#090909] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
						>
							Professioneel opgebouwd
						</p>

						<h2
							class="mt-5 text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl"
						>
							Een netwerk dat vandaag werkt én
							<span class="text-[#d4af37]"> morgen kan meegroeien.</span>
						</h2>

						<p class="mt-7 text-lg leading-8 text-neutral-400">
							Steeds meer toestellen zijn afhankelijk van uw netwerk.
							Daarom houden we niet alleen rekening met de huidige
							WiFi-dekking, maar ook met stabiliteit, bekabeling,
							uitbreidbaarheid en toekomstige apparatuur.
						</p>
					</div>

					<ul class="grid gap-4 sm:grid-cols-2">
						{
							benefits.map((benefit) => (
								<li
									class="flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5"
								>
									<span
										class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
										aria-hidden="true"
									>
										<Check size={17} strokeWidth={2.5} />
									</span>

									<span class="leading-7 text-neutral-300">
										{benefit}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- WERKWIJZE -->
		<section class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="mx-auto max-w-3xl text-center">
					<p
						class="text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
					>
						Van probleem tot oplossing
					</p>

					<h2
						class="mt-5 text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
					>
						Zo bouwen we een
						<span class="text-[#d4af37]"> betrouwbaar netwerk.</span>
					</h2>
				</div>

				<div class="mt-16 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
					{
						steps.map((step) => (
							<article
								class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-7"
							>
								<p
									class="text-4xl font-black tracking-[-0.05em] text-[#d4af37]/35"
								>
									{step.number}
								</p>

								<h3 class="mt-5 text-xl font-black text-white">
									{step.title}
								</h3>

								<p class="mt-3 leading-7 text-neutral-400">
									{step.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- TECHNIEK BLOK -->
		<section class="relative bg-[#090909] py-24 sm:py-32">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="relative overflow-hidden rounded-3xl border border-[#d4af37]/25 bg-[#111111] p-8 sm:p-10 lg:p-12"
				>
					<div
						class="absolute right-0 top-0 h-80 w-80 rounded-full bg-[#d4af37]/10 blur-[120px]"
					></div>

					<div
						class="relative grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-center"
					>
						<div
							class="flex h-20 w-20 items-center justify-center rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
						>
							<Router size={38} strokeWidth={1.8} />
						</div>

						<div>
							<p
								class="text-sm font-bold uppercase tracking-[0.22em] text-[#d4af37]"
							>
								De juiste apparatuur
							</p>

							<h2
								class="mt-4 text-3xl font-black tracking-[-0.04em] text-white sm:text-4xl"
							>
								Geen netwerk is hetzelfde.
							</h2>

							<p
								class="mt-5 max-w-3xl text-lg leading-8 text-neutral-400"
							>
								Afhankelijk van uw situatie selecteren we geschikte routers,
								switches, access points en andere netwerkcomponenten. Daarbij
								kijken we naar bereik, prestaties, bekabeling, aantal
								gebruikers en toekomstige uitbreidingen in plaats van één
								standaardoplossing te gebruiken.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section
			id="wifi-contact"
			class="relative overflow-hidden bg-[#0d0d0d] py-24 sm:py-32"
		>
			<div
				class="absolute left-1/2 top-1/2 h-[550px] w-[550px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#d4af37]/8 blur-[170px]"
			></div>

			<div class="relative mx-auto max-w-5xl px-6 text-center lg:px-8">
				<div
					class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 text-[#d4af37]"
				>
					<Gauge size={27} strokeWidth={2} />
				</div>

				<p
					class="mt-7 text-sm font-bold uppercase tracking-[0.24em] text-[#d4af37]"
				>
					Een beter netwerk begint hier
				</p>

				<h2
					class="mx-auto mt-5 max-w-4xl text-4xl font-black leading-tight tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl"
				>
					Last van slechte WiFi of toe aan een
					<span class="text-[#d4af37]"> professioneler netwerk?</span>
				</h2>

				<p
					class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-neutral-400"
				>
					Vertel ons waar u problemen ondervindt of wat u wilt uitbreiden.
					We bekijken welke netwerkoplossing het beste bij uw situatie past.
				</p>

				<div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
					<a
						href="/#contact"
						class="inline-flex min-h-14 items-center justify-center gap-2 rounded-lg bg-[#d4af37] px-8 font-black text-black transition duration-300 hover:-translate-y-1 hover:bg-white"
					>
						Vraag vrijblijvend advies
						<ArrowRight size={19} strokeWidth={2.3} />
					</a>

					<a
						href="/#projecten"
						class="inline-flex min-h-14 items-center justify-center rounded-lg border border-white/15 px-8 font-bold text-white transition duration-300 hover:-translate-y-1 hover:border-[#d4af37] hover:text-[#d4af37]"
					>
						Bekijk onze realisaties
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>